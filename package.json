{
  "name": "@momo-api/momoapi-proxy",
  "version": "0.13.29",
  "private": true,
  "description": "Lightweight local Codex & Desktop Responses bridge for MOMO API",
  "type": "module",
  "bin": {
    "momoapi-proxy": "bin/momoapi-proxy.mjs",
    "momoapi": "bin/momoapi-proxy.mjs",
    "momo": "bin/momoapi-proxy.mjs",
    "momo-codex-bridge": "bin/momoapi-proxy.mjs",
    "momo-codex-switch": "bin/momoapi-proxy.mjs"
  },
  "scripts": {
    "start": "node bin/momoapi-proxy.mjs serve",
    "test": "node scripts/run-tests-isolated.mjs",
    "release:package": "node scripts/build-release-package.mjs",
    "benchmark:compact": "node scripts/benchmark-compact-budget.mjs",
    "benchmark:incremental-stream": "node --expose-gc scripts/benchmark-incremental-stream.mjs",
    "test:output": "node --test test/output-budget.test.mjs test/output-budget-integration.test.mjs",
    "benchmark:output": "node scripts/benchmark-output-budget.mjs",
    "test:admission": "node --test test/request-admission.test.mjs test/request-admission-integration.test.mjs",
    "benchmark:admission": "node scripts/benchmark-request-admission.mjs",
    "test:stream": "node --test test/stream-transport.test.mjs test/stream-transport-integration.test.mjs",
    "benchmark:stream": "node scripts/benchmark-stream-transport.mjs",
    "build:tray": "powershell -NoProfile -File scripts/build-tray.ps1 -Embed",
    "test:tray": "powershell -NoProfile -File scripts/test-tray.ps1",
    "doctor": "node bin/momoapi-proxy.mjs doctor",
    "models": "node bin/momoapi-proxy.mjs models",
    "status": "node bin/momoapi-proxy.mjs status",
    "benchmark:multimodal:fixtures": "python scripts/generate-multimodal-fixtures.py",
    "benchmark:multimodal": "node scripts/benchmark-multimodal.mjs",
    "test:container": "podman build -t momoapi-proxy:test . && podman run --rm momoapi-proxy:test",
    "test:codex-container": "podman build -f Dockerfile.codex-smoke -t momoapi-proxy:codex-smoke . && podman run --rm momoapi-proxy:codex-smoke"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "png-to-ico": "^3.0.2"
  }
}
